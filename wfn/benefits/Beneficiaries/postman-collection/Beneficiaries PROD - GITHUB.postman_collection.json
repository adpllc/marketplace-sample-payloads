						"value": "Bearer {{accessToken}}"
					},
					{
						"key": "Content-Type",
						"type": "text",
						"value": "application/json",
						"disabled": true
					},
					{
						"key": "Accept",
						"type": "text",
						"value": "application/json;masked=false"
					},
					{
						"key": "If-None-Match",
						"type": "text",
						"value": "true"
